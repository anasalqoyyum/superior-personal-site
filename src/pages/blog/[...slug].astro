---
import { Image } from 'astro:assets'
import { type CollectionEntry, getCollection, render } from 'astro:content'
import calcReadingTime from 'reading-time'
import photo from '../../assets/images/photo.jpg'
import WaveDivider from '../../components/WaveDivider.astro'
import Layout from '../../layouts/Layout.astro'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  return posts.map(post => ({
    params: { slug: post.id },
    props: post
  }))
}

type Props = CollectionEntry<'blog'>

const post = Astro.props
const { Content } = await render(post)
const {
  title,
  summary,
  publishedAt,
  thumbnail,
  thumbnailAlt,
  thumbnailSource,
  isMultiLang,
  lang
} = post.data

const publishDate = new Date(publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
})
const { text: readingTime } = calcReadingTime(post.body || '')
const { pathname } = Astro.url
const githubFileUrl = `https://github.com/anasalqoyyum/superior-personal-site/edit/master/src/content${pathname.replace(/\/$/, '')}.md`

const alternateUrl =
  lang === 'ID'
    ? pathname.replace('/id/', '/en/')
    : pathname.replace('/en/', '/id/')
const alternateLanguage = lang === 'ID' ? 'English' : 'Bahasa Indonesia'
---

<Layout title={title} description={summary}>
  <article
    class="article-shell"
    item-prop="blogPost"
    item-scope
    item-type="https://schema.org/BlogPosting"
  >
    <header class="article-header">
      <p class="terminal-label">{lang} / {readingTime}</p>
      <h1 item-prop="name headline">{title}</h1>
      <p class="article-summary">{summary}</p>

      <div class="article-meta">
        <div class="author">
          <Image
            src={photo}
            width={44}
            height={44}
            alt=""
            class="author-photo"
          />
          <span
            item-prop="author"
            item-scope
            item-type="https://schema.org/Person"
          >
            <span item-prop="name">Anas Alqoyyum</span>
          </span>
        </div>

        <time item-prop="datePublished" datetime={publishedAt}>
          {publishDate}
        </time>
      </div>
    </header>

    <WaveDivider class="article-wave" />

    {
      thumbnail && (
        <figure class="article-cover">
          <img src={thumbnail} alt={thumbnailAlt} loading="eager" />
          {thumbnailSource && <figcaption>{thumbnailSource}</figcaption>}
        </figure>
      )
    }

    <section class="prose article-body" item-prop="articleBody">
      <Content />
    </section>

    <footer class="article-footer">
      <span>&gt; end of note</span>
      <div>
        {isMultiLang && <a href={alternateUrl}>{alternateLanguage}</a>}
        <a href={githubFileUrl}>Edit on GitHub ↗</a>
      </div>
    </footer>
  </article>
</Layout>

<style>
  .article-shell {
    width: 100%;
  }

  .article-header {
    max-width: 48rem;
    margin-inline: auto;
  }

  .article-header h1 {
    margin-top: 1rem;
    font-size: clamp(2.2rem, 6vw, 5rem);
    font-family: var(--font-sans);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .article-summary {
    max-width: 43rem;
    margin-top: 1.6rem;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: clamp(0.95rem, 1.5vw, 1.05rem);
    line-height: 1.85;
    text-wrap: pretty;
  }

  .article-meta {
    display: flex;
    max-width: 48rem;
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    color: var(--text-muted);
    font-size: 0.74rem;
  }

  .author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .author-photo {
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border-strong);
    filter: saturate(0.55) brightness(0.82);
    object-fit: cover;
  }

  .article-wave {
    max-width: 48rem;
    margin-block: 3rem;
    margin-inline: auto;
  }

  .article-cover {
    max-width: 56rem;
    margin: 0 auto 4rem;
  }

  .article-cover img {
    display: block;
    width: 100%;
    max-height: 34rem;
    border: 1px solid var(--border);
    filter: saturate(0.72) brightness(0.82);
    object-fit: cover;
  }

  .article-cover figcaption {
    margin-top: 0.7rem;
    color: var(--text-muted);
    font-size: 0.66rem;
    overflow-wrap: anywhere;
  }

  .article-body {
    margin-inline: auto;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .article-body :global(h1),
  .article-body :global(h2),
  .article-body :global(h3),
  .article-body :global(h4) {
    font-family: var(--font-sans);
  }

  .article-footer {
    display: flex;
    max-width: 48rem;
    margin: 4.5rem auto 0;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  .article-footer > span {
    color: var(--accent);
  }

  .article-footer div {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .article-footer a {
    transition: color 240ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .article-footer a:hover {
    color: var(--accent-hover);
  }

  @media (max-width: 36rem) {
    .article-meta,
    .article-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
