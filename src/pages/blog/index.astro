---
import { getCollection } from 'astro:content'
import BlogItem from '../../components/BlogItem.astro'
import WaveDivider from '../../components/WaveDivider.astro'
import { SITE_TITLE } from '../../consts'
import Layout from '../../layouts/Layout.astro'

const posts = (await getCollection('blog'))
  .filter(post => !post.data.hidden && post.id.includes('en/'))
  .sort(
    (a, b) => Date.parse(b.data.publishedAt) - Date.parse(a.data.publishedAt)
  )

const postsByYear = posts.reduce(
  (entries, post) => {
    const year = new Date(post.data.publishedAt).getFullYear()
    entries[year] ??= []
    entries[year].push(post)
    return entries
  },
  {} as Record<number, typeof posts>
)

const years = Object.keys(postsByYear)
  .map(Number)
  .sort((a, b) => b - a)
---

<Layout title={`Writing — ${SITE_TITLE}`}>
  <header class="terminal-heading">
    <p class="terminal-label">Writing</p>
    <h1>Notes from the field.</h1>
    <p>
      Software, games, useful mistakes, and the occasional thought worth
      keeping.
    </p>
  </header>

  <WaveDivider class="writing-wave" />

  <div class="writing-years">
    {
      years.map(year => (
        <section class="year-group" aria-labelledby={`year-${year}`}>
          <div class="year-rail">
            <h2 id={`year-${year}`}>{year}</h2>
            <span>{postsByYear[year].length} entries</span>
          </div>
          <ol>
            {postsByYear[year].map(post => (
              <li>
                <BlogItem url={`/blog/${post.id}`} {...post.data} />
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</Layout>

<style>
  .writing-wave {
    margin-top: calc(clamp(3rem, 7vw, 5.5rem) * -0.55);
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .writing-years {
    border-top: 1px solid var(--border);
  }

  .year-group {
    display: grid;
    border-bottom: 1px solid var(--border);
    grid-template-columns: minmax(8rem, 0.28fr) minmax(0, 1fr);
  }

  .year-rail {
    padding: 1.65rem 2rem 1.65rem 0;
    border-right: 1px solid var(--border);
  }

  .year-rail h2 {
    color: var(--accent);
    font-size: 0.88rem;
    font-weight: 500;
  }

  .year-rail span {
    display: block;
    margin-top: 0.4rem;
    color: var(--text-muted);
    font-size: 0.66rem;
  }

  .year-group ol {
    padding-left: clamp(1.25rem, 4vw, 3rem);
  }

  .year-group li:last-child :global(.writing-entry) {
    border-bottom: 0;
  }

  @media (max-width: 42rem) {
    .year-group {
      grid-template-columns: 1fr;
    }

    .year-rail {
      display: flex;
      padding: 1.5rem 0 0;
      border-right: 0;
      align-items: baseline;
      justify-content: space-between;
    }

    .year-group ol {
      padding-left: 0;
    }
  }
</style>
