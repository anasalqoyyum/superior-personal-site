---
import WaveDivider from '../components/WaveDivider.astro'
import Layout from '../layouts/Layout.astro'
import { opusMagnumSolutions } from '../utils/opus-magnum'

const title = 'Opus Magnum Solutions'
const description =
  'A gallery of my Opus Magnum solutions, with puzzle name, cost, cycles, and area.'

const formatMetric = (value: number | null, suffix = '') =>
  value === null ? 'N/A' : `${value.toLocaleString('en')}${suffix}`
---

<Layout title={`${title} — Anas Alqoyyum`} description={description}>
  <header class="terminal-heading gallery-heading">
    <p class="terminal-label">Gallery / Opus Magnum</p>
    <h1>Alchemical machines, left running.</h1>
    <p>
      Personal solutions from Zachtronics’ hex-grid programming game. Every
      machine is filed with its cost, cycles, and occupied area.
    </p>
  </header>

  <WaveDivider class="gallery-wave" />

  <div class="gallery-note">
    <span>&gt; field note</span>
    <p>
      These are working solutions, not claims of optimality. Open any recording
      to inspect it at full size.
    </p>
  </div>

  <section class="solution-ledger" aria-label="Opus Magnum solutions">
    {
      opusMagnumSolutions.map((solution, index) => (
        <article class="solution-entry">
          <a
            href={solution.src}
            target="_blank"
            rel="noreferrer noopener"
            aria-label={`Open ${solution.puzzleName} recording in a new tab`}
          >
            <div class="media-frame">
              {solution.mimeType === 'video/webm' ? (
                <video
                  autoplay
                  muted
                  loop
                  playsinline
                  preload={index < 4 ? 'auto' : 'metadata'}
                >
                  <source src={solution.src} type="video/webm" />
                </video>
              ) : (
                <img
                  src={solution.src}
                  alt={`Opus Magnum solution for ${solution.puzzleName}`}
                  loading={index < 4 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              )}
              <span>open recording ↗</span>
            </div>

            <header>
              <div>
                <h2>{solution.puzzleName}</h2>
                {solution.capturedAtLabel && (
                  <time datetime={solution.capturedAtRaw ?? undefined}>
                    {solution.capturedAtLabel}
                  </time>
                )}
              </div>

              <dl>
                <div>
                  <dt>Cost</dt>
                  <dd>{formatMetric(solution.cost, 'G')}</dd>
                </div>
                <div>
                  <dt>Cycles</dt>
                  <dd>{formatMetric(solution.cycles)}</dd>
                </div>
                <div>
                  <dt>Area</dt>
                  <dd>{formatMetric(solution.area)}</dd>
                </div>
              </dl>
            </header>
          </a>
        </article>
      ))
    }
  </section>
</Layout>

<style>
  .gallery-wave {
    margin-top: calc(clamp(3rem, 7vw, 5.5rem) * -0.55);
    margin-bottom: 2.5rem;
  }

  .gallery-note {
    display: grid;
    max-width: 54rem;
    margin-bottom: 4rem;
    gap: 1rem 2.5rem;
    grid-template-columns: 8rem 1fr;
  }

  .gallery-note span {
    color: var(--accent);
    font-size: 0.65rem;
  }

  .gallery-note p {
    color: var(--text-muted);
    font-size: 0.72rem;
    line-height: 1.75;
  }

  .solution-ledger {
    display: grid;
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .solution-entry {
    min-width: 0;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .solution-entry > a {
    display: block;
    height: 100%;
    padding: clamp(1rem, 2.5vw, 1.75rem);
  }

  .media-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--border-strong);
    background: var(--surface);
  }

  .media-frame img,
  .media-frame video {
    width: 100%;
    height: 100%;
    filter: saturate(0.72) brightness(0.82);
    object-fit: cover;
    transition:
      filter 320ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 420ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .media-frame span {
    position: absolute;
    right: 0;
    bottom: 0;
    padding: 0.45rem 0.6rem;
    background: var(--bg);
    color: var(--accent);
    font-size: 0.55rem;
    opacity: 0;
    transform: translateY(100%);
    transition:
      opacity 260ms cubic-bezier(0.32, 0.72, 0, 1),
      transform 260ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  .solution-entry a:hover .media-frame img,
  .solution-entry a:hover .media-frame video {
    filter: saturate(0.9) brightness(0.95);
    transform: scale(1.015);
  }

  .solution-entry a:hover .media-frame span {
    opacity: 1;
    transform: translateY(0);
  }

  .solution-entry header {
    padding-top: 1rem;
  }

  .solution-entry header > div:first-child {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
  }

  h2 {
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1.5;
    transition: color 240ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  time {
    color: var(--text-muted);
    font-size: 0.56rem;
    white-space: nowrap;
  }

  dl {
    display: grid;
    margin-top: 1rem;
    padding-top: 0.8rem;
    border-top: 1px dashed var(--border-strong);
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  dl div + div {
    padding-left: 1rem;
    border-left: 1px solid var(--border);
  }

  dt {
    color: var(--text-muted);
    font-size: 0.53rem;
    text-transform: uppercase;
  }

  dd {
    margin-top: 0.25rem;
    color: var(--text);
    font-size: 0.68rem;
  }

  .solution-entry a:hover h2 {
    color: var(--accent-hover);
  }

  @media (max-width: 46rem) {
    .solution-ledger {
      grid-template-columns: 1fr;
    }

    .gallery-note {
      grid-template-columns: 1fr;
    }
  }
</style>
