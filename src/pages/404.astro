---
import WaveDivider from '../components/WaveDivider.astro'
import Layout from '../layouts/Layout.astro'
---

<Layout title="Not Found">
  <section class="not-found">
    <p class="terminal-label">Error / 404-ish</p>
    <div class="error-code" aria-hidden="true">418</div>
    <h1>I’m a teapot.</h1>
    <p class="error-copy">
      The requested page wasn’t found. The server remains emotionally committed
      to the more interesting status code.
    </p>
    <WaveDivider class="error-wave" />
    <a href="/"><span aria-hidden="true">&gt;</span> Return home</a>
  </section>
</Layout>

<style>
  .not-found {
    max-width: 46rem;
  }

  .error-code {
    margin-top: 2rem;
    color: var(--border-strong);
    font-size: clamp(5rem, 18vw, 11rem);
    font-weight: 500;
    letter-spacing: -0.09em;
    line-height: 0.8;
  }

  h1 {
    margin-top: 2rem;
    font-size: clamp(1.8rem, 5vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .error-copy {
    max-width: 38rem;
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 0.76rem;
    line-height: 1.8;
  }

  .error-wave {
    margin-block: 2.5rem;
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.72rem;
    transition: color 240ms cubic-bezier(0.32, 0.72, 0, 1);
  }

  a span {
    color: var(--accent);
  }

  a:hover {
    color: var(--accent-hover);
  }
</style>
