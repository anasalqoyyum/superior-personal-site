---
export type Props = {
  href: string
}

const { href } = Astro.props
const { pathname } = Astro.url
const isActive = href !== '/' && pathname.startsWith(href)
---

<a
  href={href}
  class={`inline-block ${
    isActive
      ? 'font-bold text-slate-600 dark:text-slate-100'
      : 'border-b text-slate-500 transition-colors duration-200 hover:border-current dark:border-slate-700 dark:text-slate-300'
  }`}
>
  <slot />
</a>
