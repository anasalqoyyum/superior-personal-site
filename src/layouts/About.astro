---
import { Image } from 'astro:assets'
import photo from '../assets/images/photo.jpg'
import Layout from '../layouts/Layout.astro'

const { title } = Astro.props.content
---

<Layout title={title}>
  <header class="page-heading">
    <h1>About</h1>
  </header>

  <div class="about-layout">
    <aside>
      <Image
        src={photo}
        width={520}
        height={650}
        alt="Anas Alqoyyum"
        class="about-photo"
      />
      <dl>
        <div>
          <dt>Based</dt>
          <dd>Jepara, Indonesia</dd>
        </div>
        <div>
          <dt>Working with</dt>
          <dd>TypeScript, React, Go</dd>
        </div>
        <div>
          <dt>Elsewhere</dt>
          <dd>Arcades and alchemical engines</dd>
        </div>
      </dl>
    </aside>

    <article class="about-copy prose">
      <slot />
    </article>
  </div>
</Layout>

<style>
  .about-layout {
    display: grid;
    align-items: start;
    gap: clamp(2.5rem, 7vw, 6rem);
    grid-template-columns: minmax(12rem, 0.65fr) minmax(0, 1.35fr);
  }

  aside {
    min-width: 0;
    position: sticky;
    top: 2rem;
  }

  .about-photo {
    display: block;
    width: 100%;
    max-height: 28rem;
    border: 1px solid var(--border-strong);
    filter: saturate(0.55) brightness(0.72) contrast(1.05);
    object-fit: cover;
  }

  dl {
    border-top: 1px solid var(--border);
  }

  dl div {
    display: grid;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--border);
    gap: 1rem;
    grid-template-columns: 5.5rem 1fr;
  }

  dt {
    color: var(--accent);
    font-size: var(--size-meta);
    text-transform: uppercase;
  }

  dd {
    color: var(--text-muted);
    font-size: var(--size-meta);
    line-height: 1.5;
  }

  .about-copy {
    min-width: 0;
  }

  .about-copy :global(h2:first-child) {
    margin-top: 0;
  }

  @media (max-width: 46rem) {
    .about-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    aside {
      position: static;
      max-width: 24rem;
    }
  }
</style>
