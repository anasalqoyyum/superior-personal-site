---
import type { Props as HeadProps } from '../components/BaseHead.astro'
import BaseHead from '../components/BaseHead.astro'
import { SOCIAL_LINK } from '../consts'

const { title, description } = Astro.props as HeadProps
const { pathname } = Astro.url
const isHome = pathname === '/'

const navLinks = [
  { label: 'Writing', href: '/blog' },
  {
    label: 'Works ↗',
    href: 'https://kakekane.com',
    external: true
  },
  { label: 'About', href: '/about' },
  { label: 'Gallery', href: '/opus-magnum' }
]
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body class="preload-transitions">
    <a href="#content" class="skip-link">Skip to content</a>

    <div class="site-shell">
      <header class="site-header">
        <a href="/" class="site-brand">Anas Alqoyyum</a>

        <nav class="site-nav" aria-label="Primary navigation">
          <ul>
            {
              navLinks.map(link => {
                const isActive =
                  !link.external && pathname.startsWith(link.href)

                return (
                  <li>
                    <a
                      href={link.href}
                      aria-current={isActive ? 'page' : undefined}
                      target={link.external ? '_blank' : undefined}
                      rel={link.external ? 'noreferrer noopener' : undefined}
                    >
                      {link.label}
                    </a>
                  </li>
                )
              })
            }
          </ul>
        </nav>
      </header>

      <main
        id="content"
        class:list={['site-main', isHome && 'site-main--home']}
      >
        <slot />
      </main>

      {
        !isHome && (
          <footer class="site-footer">
            <ul>
              {SOCIAL_LINK.map(([label, href]) => (
                <li>
                  <a href={href} target="_blank" rel="noreferrer noopener">
                    {label}
                  </a>
                </li>
              ))}
            </ul>
            <span>anasalqoyyum.dev · Jepara, Indonesia</span>
          </footer>
        )
      }
    </div>

    <script is:inline>
      requestAnimationFrame(() => {
        document.body.classList.remove('preload-transitions')
      })
    </script>
  </body>
</html>
