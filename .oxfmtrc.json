{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "none",
  "printWidth": 80,
  "tabWidth": 2,
  "semi": false,
  "singleQuote": true,
  "arrowParens": "avoid",
  "astro": true,
  "sortTailwindcss": {
    "stylesheet": "./src/styles/global.css"
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    ".astro/",
    "dist/",
    ".output/",
    "**/*.mdx",
    "node_modules/",
    "pnpm-lock.yaml"
  ]
}
