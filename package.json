{
  "name": "superior-personal-site",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "format": "oxfmt --write .",
    "image:webp": "node scripts/convert-image-to-webp.mjs",
    "gif:webm": "node --experimental-strip-types scripts/convert-gif-to-webm.ts",
    "check": "pnpm lint && astro check && tsc --noEmit",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings ."
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/commit-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-rs": "^0.5.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "reading-time": "^1.5.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "wrangler": "^4.157.0"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
